<?xml version="1.0"?>
<Container version="2">
  <Name>LuckyTwitchMiner</Name>
  <Repository>ghcr.io/swissluckyfox/twitch-channel-points-miner-v2:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/SwissLuckyFox/Twitch-Channel-Points-Miner-v2_LuckyFox</Support>
  <Project>https://github.com/SwissLuckyFox/Twitch-Channel-Points-Miner-v2_LuckyFox</Project>
  <Overview>Twitch Channel Points Miner. The run.py script is included in the image and updated with each image update. Configure environment variables below.</Overview>
  <Category>GameServers:</Category>
  <WebUI>http://[IP]:[PORT:5000]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--pids-limit=2048</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Cookies" Target="/usr/src/app/cookies" Default="/mnt/user/appdata/twitch-channel-points-miner-v2/cookies" Mode="rw" Description="Persistent Twitch login cookies." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/twitch-channel-points-miner-v2/cookies</Config>
  <Config Name="Logs" Target="/usr/src/app/logs" Default="/mnt/user/appdata/twitch-channel-points-miner-v2/logs" Mode="rw" Description="Persistent log files." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/twitch-channel-points-miner-v2/logs</Config>
  <Config Name="Analytics" Target="/usr/src/app/analytics" Default="/mnt/user/appdata/twitch-channel-points-miner-v2/analytics" Mode="rw" Description="Persistent analytics data." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/twitch-channel-points-miner-v2/analytics</Config>
  <Config Name="Streamer list" Target="/usr/src/app/user-config/streamers.txt" Default="/mnt/user/appdata/twitch-channel-points-miner-v2/config/streamers.txt" Mode="ro" Description="Path to your persistent streamers.txt file. Create the file on Unraid before starting the container." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/twitch-channel-points-miner-v2/config/streamers.txt</Config>
  <Config Name="Analytics port" Target="5000" Default="5000" Mode="tcp" Description="Analytics web interface port." Type="Port" Display="always" Required="false" Mask="false">5000</Config>
  <Config Name="Twitch username" Target="TWITCH_USERNAME" Default="" Mode="" Description="Required Twitch username." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Twitch password" Target="TWITCH_PASSWORD" Default="" Mode="" Description="Optional. Leave empty to use an existing login cookie or interactive login." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Telegram chat ID" Target="TELEGRAM_CHAT_ID" Default="" Mode="" Description="Optional. Set together with the Telegram bot token, or leave both empty." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Telegram bot token" Target="TELEGRAM_BOT_TOKEN" Default="" Mode="" Description="Optional. Set together with the Telegram chat ID, or leave both empty." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Discord webhook URL" Target="DISCORD_WEBHOOK_URL" Default="" Mode="" Description="Optional. Leave empty to disable Discord notifications." Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>
